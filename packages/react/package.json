{
  "name": "@vates/data-table-react",
  "version": "0.12.0",
  "description": "React adapter for data-table",
  "license": "MIT",
  "author": "Vates",
  "homepage": "https://github.com/vatesfr/data-table/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/vatesfr/data-table/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vatesfr/data-table.git",
    "directory": "packages/react"
  },
  "keywords": [
    "table",
    "datatable",
    "sort",
    "filter",
    "group",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/data-table-react.umd.cjs",
  "module": "./dist/data-table-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/data-table-react.js",
      "require": "./dist/data-table-react.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./theme": {
      "import": "./dist/theme.js",
      "require": "./dist/theme.cjs",
      "types": "./dist/theme.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --config vite.theme.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "size": "npm run build && size-limit",
    "prepublishOnly": "npm run build"
  },
  "size-limit": [
    {
      "name": "ESM bundle (gzip)",
      "path": "dist/data-table-react.js",
      "gzip": true,
      "limit": "17 KB"
    }
  ],
  "dependencies": {
    "@vates/data-table-core": "^0.12.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@size-limit/file": "^12.1.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^12.1.0",
    "terser": "^5.50.0",
    "typescript": "^5.5.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10"
  }
}
