{
  "name": "@vates/data-table-vanilla",
  "version": "0.11.0",
  "description": "Vanilla JS adapter for data-table",
  "license": "MIT",
  "author": "Vates",
  "homepage": "https://github.com/vatesfr/data-table/tree/main/packages/vanilla#readme",
  "bugs": {
    "url": "https://github.com/vatesfr/data-table/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vatesfr/data-table.git",
    "directory": "packages/vanilla"
  },
  "keywords": [
    "table",
    "datatable",
    "sort",
    "filter",
    "group",
    "vanilla",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/data-table-vanilla.umd.cjs",
  "module": "./dist/data-table-vanilla.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/data-table-vanilla.js",
      "require": "./dist/data-table-vanilla.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./theme": {
      "import": "./dist/theme.js",
      "require": "./dist/theme.cjs",
      "types": "./dist/theme.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --config vite.theme.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "size": "npm run build && size-limit",
    "prepublishOnly": "npm run build"
  },
  "size-limit": [
    {
      "name": "ESM bundle (gzip)",
      "path": "dist/data-table-vanilla.js",
      "gzip": true,
      "limit": "27 KB"
    }
  ],
  "dependencies": {
    "@vates/data-table-core": "^0.11.0"
  },
  "devDependencies": {
    "@size-limit/file": "^12.1.0",
    "@vates/data-table-solid": "^0.11.0",
    "jsdom": "^29.1.1",
    "size-limit": "^12.1.0",
    "solid-js": "^1.9.15",
    "typescript": "^5.5.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  }
}
