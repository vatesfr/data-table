{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "incremental": true,
    "paths": {
      "@vates/data-table-core": ["../core/src/index.ts"],
      "@vates/data-table-core/locales": ["../core/src/locales.ts"],
      "@vates/data-table-core/theme": ["../core/src/theme.ts"],
      "@vates/data-table-core/dropdownDomUtils": ["../core/src/dropdownDomUtils.ts"],
      "@vates/data-table-solid": ["../solid/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
