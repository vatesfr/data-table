{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "rootDir": "src",
    "incremental": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
