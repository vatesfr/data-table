{
  "name": "@vates/data-table-core",
  "version": "0.16.0",
  "description": "Framework-agnostic core logic for data-table",
  "license": "MIT",
  "author": "Vates",
  "homepage": "https://github.com/vatesfr/data-table/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/vatesfr/data-table/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vatesfr/data-table.git",
    "directory": "packages/core"
  },
  "keywords": [
    "table",
    "datatable",
    "sort",
    "filter",
    "group",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./locales": {
      "import": "./dist/locales.js",
      "require": "./dist/locales.cjs",
      "types": "./dist/locales.d.ts"
    },
    "./theme": {
      "import": "./dist/theme.js",
      "require": "./dist/theme.cjs",
      "types": "./dist/theme.d.ts"
    },
    "./internal": {
      "import": "./dist/internal.js",
      "require": "./dist/internal.cjs",
      "types": "./dist/internal.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run --reporter=verbose",
    "type-check": "tsc --noEmit",
    "size": "size-limit",
    "prepublishOnly": "npm run build"
  },
  "size-limit": [
    {
      "name": "public entry (gzip)",
      "path": "dist/index.js",
      "gzip": true,
      "limit": "2 KB"
    }
  ],
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@size-limit/file": "^14.1.0",
    "size-limit": "^14.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  }
}
