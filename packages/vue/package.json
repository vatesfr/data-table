{
  "name": "@vates/data-table-vue",
  "version": "0.17.0",
  "description": "Vue 3 adapter for data-table",
  "license": "MIT",
  "author": "Vates",
  "homepage": "https://github.com/vatesfr/data-table/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/vatesfr/data-table/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vatesfr/data-table.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "table",
    "datatable",
    "sort",
    "filter",
    "group",
    "vue",
    "vue3",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/data-table-vue.umd.cjs",
  "module": "./dist/data-table-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/data-table-vue.js",
      "require": "./dist/data-table-vue.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./theme": {
      "import": "./dist/theme.js",
      "require": "./dist/theme.cjs",
      "types": "./dist/theme.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --config vite.theme.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit",
    "size": "size-limit",
    "prepublishOnly": "npm run build"
  },
  "size-limit": [
    {
      "name": "ESM bundle + CSS (gzip)",
      "path": [
        "dist/data-table-vue.js",
        "dist/data-table-vue.css"
      ],
      "gzip": true,
      "limit": "25.6 KB"
    }
  ],
  "dependencies": {
    "@vates/data-table-core": "^0.17.0"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@size-limit/file": "^14.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/language-core": "^3.3.12",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.1.2",
    "size-limit": "^14.1.0",
    "terser": "^5.50.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.7"
  }
}
