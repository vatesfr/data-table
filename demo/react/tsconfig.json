{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@vates/data-table-core": ["../../packages/core/src/index.ts"],
      "@vates/data-table-core/theme": ["../../packages/core/src/theme.ts"],
      "@vates/data-table-react": ["../../packages/react/src/index.ts"],
      "@vates/data-table-react/theme": ["../../packages/react/src/theme.ts"]
    }
  },
  "include": ["src"]
}
