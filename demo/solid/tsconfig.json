{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@vates/data-table-core": ["../../packages/core/src/index.ts"],
      "@vates/data-table-solid": ["../../packages/solid/src/index.ts"]
    }
  },
  "include": ["src"]
}
